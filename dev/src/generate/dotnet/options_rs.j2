#[cfg(test)]
mod tests {
    use std::ffi::{CStr, CString};

    use super::*;

    fn json(value: &str) -> CString {
        CString::new(value).unwrap()
    }

    fn message(error: &OpenDALError) -> String {
        unsafe { CStr::from_ptr(error.message) }
            .to_string_lossy()
            .into_owned()
    }

    #[test]
    fn parse_options_rejects_unknown_members() {
        let err = parse_options::<StatOptionsJson>(json(r#"{"if_matc": "x"}"#).as_ptr())
            .expect_err("a misspelled option must fail");
        assert!(message(&err).contains("unknown field"));
    }

    #[test]
    fn parse_options_defaults_on_null() {
        let options = parse_options::<ReadOptionsJson>(std::ptr::null()).unwrap();
        assert_eq!(options, opendal::options::ReadOptions::default());
    }

    #[test]
    fn parse_options_rebuilds_full_metadata() {
        let options = parse_options::<DeleteOptionsJson>(
            json(
                r#"{"if_not_changed": {
                    "mode": 0, "content_length": 5, "is_deleted": false, "is_current": true,
                    "etag": "e", "version": "v", "content_type": "text/plain",
                    "last_modified": {"second": 1700000000, "nanosecond": 123},
                    "user_metadata": {"k": "v"}
                }}"#,
            )
            .as_ptr(),
        )
        .unwrap();
        let metadata = options.if_not_changed.unwrap();
        assert!(metadata.is_file());
        assert_eq!(metadata.content_length(), 5);
        assert_eq!(metadata.is_current(), Some(true));
        assert_eq!(metadata.etag(), Some("e"));
        assert_eq!(metadata.version(), Some("v"));
        assert_eq!(metadata.content_type(), Some("text/plain"));
        assert_eq!(
            metadata.last_modified(),
            Some(Timestamp::new(1700000000, 123).unwrap())
        );
        assert_eq!(metadata.user_metadata().unwrap().get("k"), Some("v"));
    }

    #[test]
    fn parse_options_keeps_metadata_without_identity() {
        // Core must still see the condition, so it can reject metadata that
        // carries neither a version nor an ETag.
        let options = parse_options::<WriteOptionsJson>(json(r#"{"if_not_changed": {}}"#).as_ptr())
            .unwrap();
        let metadata = options.if_not_changed.unwrap();
        assert_eq!(metadata.etag(), None);
        assert_eq!(metadata.version(), None);
    }

    #[test]
    fn parse_options_decodes_nested_members() {
        let options = parse_options::<WriteOptionsJson>(
            json(r#"{"user_metadata": {"k": "v"}, "if_not_changed": {"etag": "e"}, "concurrent": 2}"#)
                .as_ptr(),
        )
        .unwrap();
        assert_eq!(options.user_metadata.unwrap()["k"], "v");
        assert_eq!(options.if_not_changed.unwrap().etag(), Some("e"));
        assert_eq!(options.concurrent, 2);
    }

    #[test]
    fn parse_options_rejects_suffix_with_offset() {
        let err = parse_options::<ReadOptionsJson>(json(r#"{"offset": 1, "suffix_length": 1}"#).as_ptr())
            .expect_err("a suffix range cannot have an offset");
        assert!(message(&err).contains("suffix_length"));
    }

    #[test]
    fn parse_path_items_keeps_order_and_defaults() {
        let items = parse_path_items::<DeleteOptionsJson>(
            json(r#"[{"path": "a", "options": {"version": "1"}}, {"path": "b"}]"#).as_ptr(),
            "targets",
        )
        .unwrap();
        assert_eq!(items[0].0, "a");
        assert_eq!(items[0].1.version.as_deref(), Some("1"));
        assert_eq!(items[1].0, "b");
        assert_eq!(items[1].1, opendal::options::DeleteOptions::default());
    }

    #[test]
    fn parse_string_map_names_null_values() {
        let err = parse_string_map(json(r#"{"root": null}"#).as_ptr())
            .expect_err("a null value must fail");
        assert!(message(&err).contains("value of option root is null"));
    }
}
